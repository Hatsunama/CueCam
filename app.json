{
  "expo": {
    "name": "CueCam",
    "slug": "cuecam",
    "version": "1.0.11",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "cuecam",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.thea.cuecam",
      "buildNumber": "12",
      "requireFullScreen": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "CueCam saves your recorded videos to Photos."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "com.thea.cuecam",
      "versionCode": 12,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#06152A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CueCam to use your camera for recording videos.",
          "microphonePermission": "Allow CueCam to record audio with your videos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow CueCam to save recorded videos to your gallery.",
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06152A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "ALL"
        }
      ],
      "expo-sqlite"
    ]
  }
}
